<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f19"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="◉"
        android:textColor="#0a84ff"
        android:textSize="48sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VARKARI MITRA"
        android:textColor="#ffffff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1e293b"
        android:padding="20dp"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:background="#0f172a"
            android:textColor="#ffffff"
            android:hintTextColor="#64748b"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="#0f172a"
            android:textColor="#ffffff"
            android:hintTextColor="#64748b"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:background="#0f172a"
                android:textColor="#ffffff"
                android:hintTextColor="#64748b"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I am a..."
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:layout_marginBottom="6dp"/>

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbVarkari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🙏 Varkari"
                    android:textColor="#ffffff"
                    android:buttonTint="#0a84ff"/>

                <RadioButton
                    android:id="@+id/rbMitra"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🤝 Mitra"
                    android:textColor="#ffffff"
                    android:buttonTint="#0a84ff"/>

                <RadioButton
                    android:id="@+id/rbSevak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛕 Sevak"
                    android:textColor="#ffffff"
                    android:buttonTint="#0a84ff"/>
            </RadioGroup>

            <TextView
                android:id="@+id/tvEkycHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eKYC verification required after registration"
                android:textColor="#ff9f0a"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ff3b30"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:background="#0a84ff"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Register"
            android:background="transparent"
            android:textColor="#0a84ff"
            android:textStyle="bold"
            android:padding="10dp"/>

    </LinearLayout>

</LinearLayout>
